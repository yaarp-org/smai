{
  "name": "@smai/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "routes:generate": "tsr generate",
    "dev": "tsr generate && vite",
    "build": "tsr generate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen": "uv --project ../.. run python ../../tools/dump_openapi.py | openapi-typescript --output src/lib/api/generated/api-types.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/react-query-devtools": "^5.100.0",
    "@tanstack/react-router": "^1.169.0",
    "@tanstack/react-router-devtools": "^1.166.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.0",
    "react": "^19.0.0",
    "react-diff-viewer-continued": "^4.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "rehype-shiki": "^0.0.9",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-cli": "^1.166.0",
    "@tanstack/router-plugin": "^1.167.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vite": "^6.0.0"
  }
