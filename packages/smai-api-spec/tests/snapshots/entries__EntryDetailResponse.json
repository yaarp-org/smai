{
  "$defs": {
    "RunSummary": {
      "additionalProperties": false,
      "description": "Per-run summary \u2014 embedded in CG-detail and entry-detail responses,\nand returned as the page-item type for ``GET /api/v1/runs``.\n\nPer ``11`` \u00a75.1.2 the lease triple is NOT exposed; ``compute_job_handle``\nis also withheld as an orchestrator-internal opaque token.",
      "properties": {
        "cg_id": {
          "title": "Cg Id",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "entry_id": {
          "title": "Entry Id",
          "type": "string"
        },
        "failure_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Reason"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "raw_metrics_artifact_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Metrics Artifact Key"
        },
        "run_attempt": {
          "title": "Run Attempt",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state": {
          "enum": [
            "pending",
            "submitted",
            "running",
            "succeeded",
            "failed",
            "inconclusive"
          ],
          "title": "State",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "cg_id",
        "entry_id",
        "seed",
        "state",
        "run_attempt",
        "updated_at"
      ],
      "title": "RunSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Full entry detail. Returned by\n``GET /api/v1/comparison-groups/{cg_id}/entries/{entry_id}``.\n\nMirrors :class:`EntryWithRuns` \u2014 same shape, exposed at a dedicated\nURL for clients that already know the entry id.",
  "properties": {
    "cg_id": {
      "title": "Cg Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "harness_api_manifest_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Harness Api Manifest Hash"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "implementation_attempt": {
      "title": "Implementation Attempt",
      "type": "integer"
    },
    "is_baseline": {
      "title": "Is Baseline",
      "type": "boolean"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunSummary"
      },
      "title": "Runs",
      "type": "array"
    },
    "state": {
      "enum": [
        "pending",
        "implementing",
        "implemented",
        "implementation_failed"
      ],
      "title": "State",
      "type": "string"
    },
    "technique_contract_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Technique Contract Hash"
    },
    "technique_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Technique Id"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "version",
    "id",
    "cg_id",
    "technique_id",
    "is_baseline",
    "state",
    "technique_contract_hash",
    "harness_api_manifest_hash",
    "implementation_attempt",
    "runs"
  ],
  "title": "EntryDetailResponse",
  "type": "object"
}
