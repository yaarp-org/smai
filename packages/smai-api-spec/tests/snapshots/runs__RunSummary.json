{
  "additionalProperties": false,
  "description": "Per-run summary \u2014 embedded in CG-detail and entry-detail responses,\nand returned as the page-item type for ``GET /api/v1/runs``.\n\nPer ``11`` \u00a75.1.2 the lease triple is NOT exposed; ``compute_job_handle``\nis also withheld as an orchestrator-internal opaque token.",
  "properties": {
    "cg_id": {
      "title": "Cg Id",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "entry_id": {
      "title": "Entry Id",
      "type": "string"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "raw_metrics_artifact_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Metrics Artifact Key"
    },
    "run_attempt": {
      "title": "Run Attempt",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "enum": [
        "pending",
        "submitted",
        "running",
        "succeeded",
        "failed",
        "inconclusive"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "cg_id",
    "entry_id",
    "seed",
    "state",
    "run_attempt",
    "updated_at"
  ],
  "title": "RunSummary",
  "type": "object"
}
