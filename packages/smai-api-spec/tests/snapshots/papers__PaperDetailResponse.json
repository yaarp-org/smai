{
  "$defs": {
    "TechniqueRefSummary": {
      "additionalProperties": false,
      "description": "One paper-derived ``TechniqueRef`` exposed on the paper detail.\n\nPer DEC-032 / ``08`` \u00a75: paper ingestion produces a buffer of\n``TechniqueRef``s; the API exposes them on the paper-detail\nresponse so the SPA can render \"this paper produced N techniques;\nsubmit a reproduce-paper proposal to run them.\"\n\nThe internal record shape is wider than this projection \u2014 the\ncontract surface here exposes only what the SPA needs to render +\nreference for a follow-up proposal.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "technique_id": {
          "title": "Technique Id",
          "type": "string"
        }
      },
      "required": [
        "technique_id"
      ],
      "title": "TechniqueRefSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Full paper detail. Job handles are NOT exposed (orchestrator-internal).",
  "properties": {
    "abstract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Abstract"
    },
    "arxiv_id": {
      "title": "Arxiv Id",
      "type": "string"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "categories": {
      "items": {
        "type": "string"
      },
      "title": "Categories",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_context_artifact_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Context Artifact Key"
    },
    "expanded_tex_artifact_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expanded Tex Artifact Key"
    },
    "extracted_text_artifact_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Extracted Text Artifact Key"
    },
    "figures_artifact_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Figures Artifact Key"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "latex_bundle_artifact_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Latex Bundle Artifact Key"
    },
    "planning_attempt": {
      "title": "Planning Attempt",
      "type": "integer"
    },
    "published_date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Published Date"
    },
    "registration_attempt": {
      "title": "Registration Attempt",
      "type": "integer"
    },
    "screen_result_decision": {
      "anyOf": [
        {
          "enum": [
            "accept",
            "reject"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Screen Result Decision"
    },
    "screen_result_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Screen Result Reason"
    },
    "screening_attempt": {
      "title": "Screening Attempt",
      "type": "integer"
    },
    "state": {
      "enum": [
        "submitted",
        "fetching",
        "screening",
        "planning",
        "registered",
        "rejected",
        "failed",
        "partial"
      ],
      "title": "State",
      "type": "string"
    },
    "technique_buffer_artifact_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Technique Buffer Artifact Key"
    },
    "technique_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TechniqueRefSummary"
      },
      "title": "Technique Refs",
      "type": "array"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Title"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "created_at",
    "updated_at",
    "version",
    "arxiv_id",
    "state",
    "title",
    "authors",
    "abstract",
    "published_date",
    "categories",
    "latex_bundle_artifact_key",
    "expanded_tex_artifact_key",
    "extracted_text_artifact_key",
    "figures_artifact_key",
    "screen_result_decision",
    "screen_result_reason",
    "technique_buffer_artifact_key",
    "error_context_artifact_key",
    "planning_attempt",
    "screening_attempt",
    "registration_attempt"
  ],
  "title": "PaperDetailResponse",
  "type": "object"
}
